{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Script",
            "type": "shell",
            "command": "cmd /c \"\"${workspaceFolder}\\.vscode\\run-script.bat\" \"${file}\"\"",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "close": false,
                "focus": true
            },
            "problemMatcher": []
        }
    ]
}